{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessforge.dev/schemas/forge-layout-v1.schema.json",
  "title": "HarnessForge project layout v1",
  "description": "Schema for .forge/forge.yaml. layout_version is independent from the selected canonical IR version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["layout_version", "ir_version", "project", "targets", "references"],
  "properties": {
    "layout_version": { "const": 1 },
    "ir_version": { "enum": [1, 2] },
    "project": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "$ref": "#/$defs/text" }, "languages": { "$ref": "#/$defs/texts" } }
    },
    "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["codex", "claude"] } },
    "references": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "knowledge": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": { "id": { "$ref": "#/$defs/text" }, "path": { "$ref": "#/$defs/relativePath" } } } },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } }
      }
    },
    "quality_gates": { "type": "array", "items": { "$ref": "#/$defs/qualityGate" } }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "texts": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))\\S.*$" },
    "qualityGate": {
      "type": "object", "additionalProperties": false, "required": ["id", "command"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "command": { "$ref": "#/$defs/text" },
        "workspace": { "$ref": "#/$defs/relativePath" },
        "workspaces": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } }
      }
    }
  }
}
